# ----------------------------------------------------------------------------
# OSINTp configuration. Copy to `.env` and adjust. All values are optional;
# sensible defaults are applied when unset.
# ----------------------------------------------------------------------------

# Application
APP_NAME=OSINTp
DEBUG=false
ENVIRONMENT=development

# HTTP client tuning
HTTP_TIMEOUT=10.0
HTTP_MAX_CONNECTIONS=50
USER_AGENT=OSINTp/0.1 (+https://github.com/zapayox30/osintp)

# Maximum number of concurrent outbound probes per request
MAX_CONCURRENCY=20

# CORS: comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# Optional API keys. Modules that need them are skipped automatically if unset.
# ----------------------------------------------------------------------------

# ipinfo.io token (richer IP intelligence). https://ipinfo.io/signup
IPINFO_TOKEN=

# HaveIBeenPwned API key (email breach lookups). https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Shodan API key (host ports/services/vulns in the IP module). https://account.shodan.io
SHODAN_API_KEY=

# ----------------------------------------------------------------------------
# Production hardening (all optional)
# ----------------------------------------------------------------------------

# If set, the API requires this key via the 'X-API-Key' header or '?api_key='.
# Leave empty to keep the API open (default).
API_KEY=

# Requests per minute per client IP (0 disables rate limiting)
RATE_LIMIT_PER_MINUTE=0

# In-memory cache TTL for outbound lookups, in seconds (0 disables caching)
CACHE_TTL_SECONDS=300

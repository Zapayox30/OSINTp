# ----------------------------------------------------------------------------
# OSINTp configuration. Copy to `.env` and adjust. All values are optional;
# sensible defaults are applied when unset.
# ----------------------------------------------------------------------------

# Application
APP_NAME=OSINTp
DEBUG=false
ENVIRONMENT=development

# HTTP client tuning
HTTP_TIMEOUT=10.0
HTTP_MAX_CONNECTIONS=50
USER_AGENT=OSINTp/0.1 (+https://github.com/zapayox30/osintp)

# Maximum number of concurrent outbound probes per request
MAX_CONCURRENCY=20

# CORS: comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# Optional API keys. Modules that need them are skipped automatically if unset.
# ----------------------------------------------------------------------------

# ipinfo.io token (richer IP intelligence). https://ipinfo.io/signup
IPINFO_TOKEN=

# HaveIBeenPwned API key (email breach lookups). https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
